# O Create React App só injeta no bundle variáveis com prefixo REACT_APP_.
# No Vercel as variáveis se chamam APP_API_URL e APP_WEBSOCKET_URL;
# aqui elas são repassadas para os nomes REACT_APP_ que o código usa.
REACT_APP_API_URL=$APP_API_URL
REACT_APP_WEBSOCKET_URL=$APP_WEBSOCKET_URL
REACT_APP_WEBSOCKET_PATH=/socket.io
