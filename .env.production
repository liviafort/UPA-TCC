# URLs de produção (Vercel).
# Os nomes têm o prefixo REACT_APP_UPA_ de propósito: no painel do Vercel ainda
# existem REACT_APP_API_URL / REACT_APP_WEBSOCKET_URL antigas (api.vejamaisaude.com),
# que teriam prioridade sobre este arquivo. Com nomes novos, valem os valores abaixo.
# Essas URLs vão para o bundle público de qualquer forma; não são segredo.
REACT_APP_UPA_API_URL=https://vejamaissaudeapi.lembretto.com
REACT_APP_UPA_WEBSOCKET_URL=https://vejamaissaudeapi.lembretto.com
REACT_APP_WEBSOCKET_PATH=/socket.io
